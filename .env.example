# Путь к SQLite-файлу (по умолчанию: data/prices.sqlite)
# DB_PATH=data/prices.sqlite

# TTL кеша в часах (по умолчанию: 4)
# CACHE_TTL_HOURS=4

# SOCKS5/HTTP-прокси для всех HTTP-парсеров
# PROXY=socks5://127.0.0.1:1080

# Сохранять raw HTTP-ответы парсеров в parser_snapshot для отладки.
# Когда включено, каждый ответ при /search записывается в БД (до 1 МБ на запрос).
# Видно на /dashboard в табе «Парсеры» секция «Snapshots». В проде защищать
# /api/debug/* через reverse proxy или флаг DEBUG_API.
# ENABLE_RAW_SNAPSHOTS=1
