# =============================================================================
# Шаблон переменных окружения для boardgames-platform.
# Копируется как `.env` (`cp .env.example .env`) и заполняется. Реальный `.env`
# в индекс не попадает (см. .gitignore).
#
# Файл одновременно используется:
#   1) docker-compose (читает `.env` автоматически из текущей директории)
#   2) каждым сервисом при локальном запуске `uv run --package <name> ...`
#      (FastAPI читает env через pydantic-settings или os.getenv)
# =============================================================================

# === Общие ===
LOG_LEVEL=INFO

# === Postgres (используется catalog'ом) ===
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog
# Внешний порт хоста (внутри контейнера всегда 5432).
# 5433 — нестандартный, чтобы не конфликтовать с локальным postgres.
POSTGRES_PORT=5433

# === Catalog (services/catalog) ===
CATALOG_PORT=8002
# Локальный запуск:
DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/catalog
# В docker compose DATABASE_URL переопределяется на postgres:5432 (имя сервиса
# внутри сети bg). См. docker-compose.yml.

# Тестовая БД для pytest. Conftest требует, чтобы имя БД содержало 'test',
# иначе фикстура clean_db (TRUNCATE CASCADE) уничтожила бы prod данные.
# Создание БД (один раз):
#   docker exec bg-postgres createdb -U catalog catalog_test
#   cd services/catalog && DATABASE_URL=$TEST_DATABASE_URL \
#     uv run --package boardgames-catalog alembic upgrade head
TEST_DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/catalog_test

# Включение X-API-Key middleware. 0 = выключено (dev/CI), 1 = включено (prod).
REQUIRE_AUTH=0

# Опциональный API-ключ для prod (генерируется через `python -m catalog.cli create-key`).
# CATALOG_API_KEY=

# === BGG API Sync (services/catalog) ===
# Bearer-токен для BGG XML API v2 (обязателен с 2025-го; без него — 401).
# Получить на: https://boardgamegeek.com/account/preferences
BGG_API_TOKEN=f6a5ed50-8f9c-404b-9548-e959fdf14d39

# Еженедельный sync TOP-N игр (полное обогащение через XML API).
# Формат расписания: unix cron «мин час день_мес мес день_нед» (UTC).
BGG_TOP_SYNC_ENABLED=true
BGG_TOP_SYNC_RANK_LE=1000
BGG_TOP_SYNC_SKIP_RECENT_DAYS=7
BGG_TOP_SYNC_CRON=0 3 * * 1

# Ежедневный snapshot BGG Hotness-списка.
BGG_HOTNESS_SYNC_ENABLED=true
BGG_HOTNESS_SYNC_CRON=0 6 * * *
# Авто-импорт игр из Hotness, которых ещё нет в каталоге.
BGG_HOTNESS_AUTO_IMPORT=true

# On-demand обновление при ingest: если BGG-данные игры старше N дней
# и оффер auto-matched — запустить enrich_one в фоне. 0 = выключено.
BGG_INGEST_ENRICH_STALENESS_DAYS=14

# === Parsers (services/parsers) ===
PARSERS_PORT=8001
# Время жизни кеша магазина в часах (по истечении — парсер ходит в сеть).
CACHE_TTL_HOURS=4
# Запись raw HTTP-ответов парсеров в parser_snapshot (диагностика через /dashboard).
# ENABLE_RAW_SNAPSHOTS=1
# SOCKS5/HTTP-прокси для всех парсеров.
# PROXY=socks5://127.0.0.1:1080

# Webhook на catalog (если задан — parsers пушат собранные офферы в catalog).
# Локальный запуск:
CATALOG_INGEST_URL=http://localhost:8002/ingest/offers
# В docker compose: http://catalog:8002/ingest/offers (см. compose).

# === Browser (services/browser) ===
BROWSER_PORT=8003
# Максимум параллельных BrowserContext (~150-200 MB RAM каждый).
BROWSER_MAX_CONCURRENT=3
# Прокси для всех браузерных fetch (SOCKS5 или HTTP).
# Авито и другие сайты с GeoIP-блокировкой требуют RU-IP.
# BROWSER_PROXY_URL=socks5://user:pass@proxy.ru:1080
# URL для parsers (внутри docker-сети bg). Пусто = browser-клиент выключен.
# Раскомментировать при запуске с --profile browser:
BROWSER_SERVICE_URL=http://browser:8003
# Выбор backend зависит от архитектуры и окружения:
#
# AMD64 (облако, x86_64) — Google Chrome (установлен в Dockerfile):
#   BROWSER_BACKEND=playwright
#   BROWSER_CHANNEL=chrome
#
# ARM64 (Mac Apple Silicon) — два варианта:
#   Вариант A (рекомендован для avito.ru): нативный Mac Chrome вне Docker
#     → запусти: BROWSER_CHANNEL=chrome uv run --package browser uvicorn browser.api:app --port 8003
#     → BROWSER_SERVICE_URL=http://host.docker.internal:8003
#   Вариант B: Camoufox в Docker (не проходит Qrator avito.ru, но работает для др. сайтов)
#     BROWSER_BACKEND=camoufox
#
# BROWSER_BACKEND=playwright
# BROWSER_CHANNEL=chrome

# === Авито — куки из реального браузера (обход Qrator) ===
# Qrator различает headless Playwright и реальный Chrome по накопленным кукам
# (особенно _avisc). Без AVITO_COOKIES парсер использует persistent profile
# (куки накапливаются), но первые запросы блокируются.
#
# Как получить куки:
#   1. Откройте https://www.avito.ru в Chrome, убедитесь что страница загружается.
#   2. Установите расширение "EditThisCookie" или "Cookie-Editor".
#   3. Экспортируйте куки домена .avito.ru в JSON-формат.
#   4. Сохраните файл, например в .scratch/avito_cookies.json (gitignored).
#   5. Пропишите путь:
# AVITO_COOKIES=/path/to/avito_cookies.json
#
# Или вставьте JSON напрямую (без кавычек, всё в одну строку):
# AVITO_COOKIES=[{"name":"_avisc","value":"...","domain":".avito.ru","path":"/"}]

# === Web-test (services/web-test) ===
WEB_TEST_PORT=8000
# Локальный запуск:
PARSERS_API_URL=http://localhost:8001
CATALOG_API_URL=http://localhost:8002
# В docker compose URL переопределяются на http://parsers:8001 и
# http://catalog:8002 (см. compose).
