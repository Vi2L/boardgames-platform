# Скопировать в .env при локальной разработке вне docker-compose.
# В compose-режиме переменные приходят из boardgames-infra/.env.

# Async DSN для SQLAlchemy (asyncpg-драйвер).
DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/catalog

LOG_LEVEL=INFO

# X-API-Key authentication. По умолчанию выключена. В prod установить REQUIRE_AUTH=1
# и сгенерировать ключи через `python -m catalog.cli create-key ...`.
# REQUIRE_AUTH=0
