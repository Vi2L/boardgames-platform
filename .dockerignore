# Исключения для docker build context.
#
# Сервис web-test использует root-context (`build.context: .` в compose),
# поэтому корневой .dockerignore нужен, чтобы не отправлять в build daemon
# `.git/`, `.venv/`, `node_modules/` и прочее, что в финальный образ не идёт.
# Без этого Docker отправляет сотни МБ при каждом build.

.git
.gitignore
.dockerignore

# Python venv и кеши
.venv
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/build
**/dist

# Node
**/node_modules

# Локальные данные сервисов (SQLite-файлы)
services/*/data
*.sqlite
*.sqlite-journal

# Документация и Claude Code
docs
.claude
README.md
**/README.md
**/CLAUDE.md

# Plan файлы и envs
.env
.env.local
.env.*.local

# --- Тесты ---
# В production-образах не нужны. Каждый сервис тестируется отдельно.
**/tests

# --- Скрипты разработчика и временные артефакты ---
# `.scratch/` (cookies для парсеров, backup-дампы) монтируется как volume
# в compose, в build context отправлять не нужно — это десятки МБ.
.scratch
bin
*.log
*.tmp

# --- IDE и OS ---
.idea
.vscode
.DS_Store
**/.DS_Store

# --- Локальные тулчейн-артефакты ---
# uv.lock (~450 KB) — пока ни один Dockerfile его не использует
# (билд идёт через pyproject.toml). Если переходим на reproducible
# builds через `uv sync --frozen` — эту строку убрать.
uv.lock
.python-version
